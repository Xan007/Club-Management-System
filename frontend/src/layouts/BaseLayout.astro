---
import Navbar from '../components/Navbar.astro'
import AccessibilityToolbar from '../components/AccessibilityToolbar.astro'
import faviconIco from '../assets/logo_corpmeta.ico'

interface Props {
  title?: string
  hideNavbar?: boolean
  fullWidth?: boolean
}

const {
  title = 'Corporación Club del Meta',
  hideNavbar = false,
  fullWidth = false,
} = Astro.props as Props

// Obtener número de WhatsApp desde la base de datos
 
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/x-icon" href={faviconIco} />
    <meta
      name="description"
      content="Portal del Club El Meta para reservar salones y espacios exclusivos."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles/accessibility.css" />
    <style>
      :root {
        color-scheme: light;
        --color-primary: #0a4ba5;
        --color-secondary: #bfc3c7;
        --color-accent: #c57d3d;
        --color-background: #f4f6f9;
        --color-surface: #ffffff;
        --color-text: #1f2933;
      }

      *, *::before, *::after {
        box-sizing: border-box;
      }

      .layout {
        margin: 0;
        font-family: 'Poppins', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        background: var(--color-background);
        color: var(--color-text);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      .main {
        flex: 1;
        width: min(1650px, 95%);
        margin: 0 auto;
        padding: 3rem 0;
      }

      .layout--full {
        background: #07193a;
      }

      .layout--full .main {
        width: 100%;
        margin: 0;
        padding: 0;
      }

      footer {
        background: #1f2937;
        color: #f9fafb;
        padding: 3rem 2rem 2rem;
        font-size: 0.9rem;
      }

      .footer-container {
        max-width: 1400px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 3rem;
        text-align: left;
      }

      .footer-section h3 {
        font-size: 1.25rem;
        margin: 0 0 1rem;
        font-weight: 600;
        color: #ffffff;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .footer-section p {
        margin: 0.5rem 0;
        line-height: 1.7;
        color: #d1d5db;
      }

      .footer-section a {
        color: #93c5fd;
        text-decoration: none;
        transition: color 0.2s ease;
      }

      .footer-section a:hover {
        color: #60a5fa;
      }

      .social-icons {
        display: flex;
        gap: 0.85rem;
        margin-top: 1rem;
      }

      .social-icons a {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        transition: transform 0.2s ease, background 0.2s ease;
      }

      .social-icons a:hover {
        transform: translateY(-3px);
      }

      .social-icons .facebook {
        background: #3b5998;
      }

      .social-icons .facebook:hover {
        background: #2d4373;
      }

      .social-icons .instagram {
        background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
      }

      .social-icons .instagram:hover {
        background: linear-gradient(45deg, #d47b2a 0%, #c55533 25%, #b81f3a 50%, #a61d5a 75%, #931477 100%);
      }

      .footer-copyright {
        text-align: center;
        margin-top: 3rem;
        padding-top: 2rem;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        font-size: 0.875rem;
        color: #9ca3af;
      }

      

      @media (max-width: 768px) {
        footer {
          padding: 2.5rem 1.5rem 1.5rem;
        }

        .footer-container {
          grid-template-columns: 1fr;
          gap: 2rem;
          text-align: center;
        }

        .social-icons {
          justify-content: center;
        }

        
      }

      a {
        color: inherit;
      }

      /* Botón flotante de WhatsApp */
      .whatsapp-float {
        position: fixed;
        width: 60px;
        height: 60px;
        bottom: 100px;
        right: 30px;
        background-color: #25d366;
        color: #FFF;
        border-radius: 50px;
        text-align: center;
        font-size: 30px;
        box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.3);
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        text-decoration: none;
      }

      .whatsapp-float:hover {
        background-color: #128c7e;
        transform: scale(1.1);
        box-shadow: 2px 2px 15px rgba(0, 0, 0, 0.4);
      }

      @media (max-width: 768px) {
        .whatsapp-float {
          width: 50px;
          height: 50px;
          bottom: 20px;
          right: 20px;
          font-size: 25px;
        }
      }
    </style>
  </head>
  <body class={fullWidth ? 'layout layout--full' : 'layout'}>
    {!hideNavbar && <Navbar />}
    <main id="main-content" class={fullWidth ? 'main main--full' : 'main'}>
      <slot />
    </main>

    <!-- Herramientas de accesibilidad -->
    <AccessibilityToolbar />

    <!-- Botón flotante de WhatsApp -->
    <a 
      href="https://wa.me/573507016630" 
      class="whatsapp-float" 
      target="_blank" 
      rel="noopener noreferrer"
      aria-label="Contactar por WhatsApp"
    >
      <svg width="35" height="35" fill="currentColor" viewBox="0 0 24 24">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </a>

    <footer>
      <div class="footer-container">
        <div class="footer-section">
          <h3>Teléfonos</h3>
          <p>(8) 6 64 11 15 - 312 4347893</p>
          <p>EVENTOS: 310 8874473 - 312 4350412</p>
          <p>COMPRAS: 310 8771304</p>
          <p>CARTERA: 313 2349780</p>
          <p>OPERACIONES: 313 4660698</p>
        </div>
        <div class="footer-section">
          <h3>Dirección</h3>
          <p>CALLE 48A CARRERA 30</p>
          <p>BARRIO CIUDAD ORIENTAL</p>
          <p>VILLAVICENCIO - META</p>
          <div class="social-icons">
            <a href="https://www.facebook.com/ClubelMeta/?locale=es_LA" class="facebook" aria-label="Facebook" target="_blank" rel="noopener noreferrer">
              <svg width="20" height="20" fill="white" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
            <a href="https://www.instagram.com/clubelmeta/?hl=es-la" class="instagram" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
              <svg width="20" height="20" fill="white" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
          </div>
        </div>
        <div class="footer-section">
          <h3>Email</h3>
          <p>
            <a href="mailto:comunicaciones@clubelmeta.com">comunicaciones@clubelmeta.com</a>
          </p>
          <p>
            <a href="mailto:secretaria@clubelmeta.com">secretaria@clubelmeta.com</a>
          </p>
        </div>
      </div>
      <div class="footer-copyright">
        © Corporación Club del Meta - Todos los derechos reservados.
      </div>
    </footer>
  </body>
</html>
